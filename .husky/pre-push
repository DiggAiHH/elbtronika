#!/bin/sh
# LOCAL CI GATE (GitHub Actions is billing-locked — this is the replacement).
# Runs lint + typecheck + all unit tests before every push (~2-3 min).
# Full build check: run scripts/local-ci.cmd manually before merges to main.
# Emergency bypass (document why in the commit!): git push --no-verify
#
# stdin carries the ref lines git feeds to pre-push hooks — redirect it away
# from cmd.exe, otherwise cmd executes "refs/heads/main ..." as a command
# after the gate finishes.

echo "[pre-push] local ci gate (fast) ..."
cmd.exe /c "scripts\\local-ci.cmd fast" < /dev/null
exit $?
