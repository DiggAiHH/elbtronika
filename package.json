{
  "name": "elbtronika",
  "private": true,
  "version": "0.0.0",
  "description": "ELBTRONIKA – Immersive 3D Art Gallery & E-Commerce Platform",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck --concurrency=2",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "clean": "turbo run clean && rm -rf node_modules",
    "dr:setup": "node scripts/dr-blast.mjs --setup",
    "dr:blast": "node scripts/dr-blast.mjs",
    "dr:tiers": "node scripts/check-tiers.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "turbo": "^2.10.4",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "vite": "^8.0.10",
      "postcss": "^8.5.10"
    }
  }
}
